{
  "name": "uk-company-job-scraper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local Fieldwork dashboard for importing company spreadsheets and exporting confirmed UK jobs.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "ui": "tsx server/main.ts",
    "start": "npm run ui",
    "typecheck": "tsc --noEmit",
    "typecheck:app": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "tsx --test tests/*.integration.ts",
    "check": "npm run typecheck && npm test && npm run test:browser"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "fflate": "0.8.3",
    "playwright": "1.63.0",
    "read-excel-file": "9.3.10",
    "robots-parser": "3.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
