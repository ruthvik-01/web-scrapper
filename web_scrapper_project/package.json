{
  "name": "uk-company-job-scraper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-universal/universal.js",
  "types": "dist-universal/universal.d.ts",
  "description": "Scrape one company careers URL at a time into recent UK job rows.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "scrape:universal": "node dist-universal/universal.js",
    "verify:deployment": "tsx scripts/verify-universal-deployment.ts",
    "universal": "node dist-universal/universal.js",
    "build": "tsx scripts/build-universal-config.ts --clean && tsc -p tsconfig.build.json && tsx scripts/build-universal-config.ts",
    "test:uk": "tsx scripts/check-company-uk-scope.ts",
    "compare:scrapers": "tsx scripts/compare-scrapers.ts",
    "test:regression": "tsx scripts/regress-universal.ts",
    "ui": "tsx server/main.ts",
    "start": "npm run ui",
    "scrape": "tsx scraper.ts",
    "batch": "tsx batch.ts",
    "package:batch": "tsx scripts/package-batch.ts",
    "scrape:five": "tsx scripts/run-five-companies.ts",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.audit.json",
    "typecheck:all": "tsc --noEmit",
    "typecheck:app": "tsc --noEmit -p tsconfig.app.json",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "tsx --test tests/*.integration.ts",
    "check": "npm run typecheck && npm test && npm run test:browser"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "fflate": "0.8.3",
    "playwright": "1.63.0",
    "read-excel-file": "9.3.10",
    "robots-parser": "3.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
