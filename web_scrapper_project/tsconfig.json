{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["scraper.ts", "batch.ts", "src/**/*.ts", "scripts/**/*.ts", "server/**/*.ts", "tests/**/*.ts"]
}
