  "include": [
    "arona/arona_scraper.ts",
    "cityofalamogordo/alamogordo_scraper.ts",
    "farrow/farrow_ball_scraper.ts",
    "garver/garver_scraper.ts",
    "socorro/socorro_scraper.ts",
    "uscourts/uscourts_scraper.ts"
  ]
}
